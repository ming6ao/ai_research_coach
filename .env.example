# AI Research Coach — example environment file.
# Copy to `.env` and fill in real values; never commit `.env` itself.
#   cp .env.example .env
# In production, prefer real environment variables / your platform's secret
# manager over uploading a `.env` file (`os.getenv` already takes precedence
# over `.env` in `backend/main.py`).

# Required: Gemini API key for the LLM judge/coach + task decomposition.
GOOGLE_API_KEY=

# Optional: model + retry tuning (defaults in coach/config.py).
EVAL_MODEL=gemini-3.5-flash-lite
EVAL_RETRY_ATTEMPTS=5
EVAL_RETRY_INITIAL_DELAY=1.0
EVAL_RETRY_MAX_DELAY=30.0

# Optional: Google OAuth login. Set BOTH to enable, or NEITHER to run
# guests-only. Partial config disables login with a startup warning.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# Optional: URLs / CORS.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# Optional: comma-separated admin emails for /admin deletes.
ADMIN_EMAILS=

# Optional: override the SQLite file (defaults to data/coach.db, gitignored).
LEARNING_PARTNER_DB_URL=

# Optional: set to `production` to turn missing/insecure config into a
# startup error instead of a warning (see coach/env_config.py).
APP_ENV=development
